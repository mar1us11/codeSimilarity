# Copy to .env and adjust for your local Postgres install.
CODEGUARD_DATABASE_URL=postgresql+psycopg://codeguard:codeguard@localhost:5432/codeguard
CODEGUARD_CORS_ORIGINS=http://localhost:5173
CODEGUARD_LOG_LEVEL=INFO

# Winnowing parameters (structural fingerprinting)
CODEGUARD_WINNOW_K=5
CODEGUARD_WINNOW_WINDOW=4

# Pipeline fusion weights (must sum to 1.0)
CODEGUARD_WEIGHT_TED=0.5
CODEGUARD_WEIGHT_WINNOW=0.35
CODEGUARD_WEIGHT_CALLGRAPH=0.15

# Minimum per-function similarity for a bipartite match edge
CODEGUARD_MATCH_THRESHOLD=0.6

# Minimum fused similarity for two submissions to be linked in a suspicion cluster
CODEGUARD_CLUSTER_THRESHOLD=0.75

# --- OpenAI (optional: AI reference-solution generation) -------------------
# Required only when "Compare Against AI Reference Solutions" is enabled.
# Read directly from the unprefixed OPENAI_API_KEY variable. Do NOT commit a real key.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
